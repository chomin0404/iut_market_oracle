# IUT Market Oracle — environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# API key required for protected endpoints (gnss, risk, valuation).
# Leave unset to run in open/dev mode.
ORACLE_API_KEY=

# API key required for the /ideas/parse endpoint.
# Leave unset to run in open/dev mode.
IDEAS_API_KEY=

# Anthropic API key — required for /ideas/parse to call the Claude API.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins.
# Set to * (default) to allow all origins.
# Example: CORS_ORIGINS=https://myapp.example.com,https://staging.example.com
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Maximum requests per IP per minute. Set to 0 (default) to disable.
# Note: in-process only — not shared across multiple Uvicorn workers.
RATE_LIMIT_RPM=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root directory for experiment metadata files (default: experiments).
EXPERIMENTS_ROOT=experiments
